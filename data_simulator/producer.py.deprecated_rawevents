import json
import time
import random
import sys
from kafka import KafkaProducer
from kafka.errors import NoBrokersAvailable

KAFKA_BOOTSTRAP = "kafka:9092"
TOPIC = "raw-events"
RETRY_DELAY = 5  # seconds

def create_producer():
    """Retry Kafka connection until broker is ready"""
    while True:
        try:
            producer = KafkaProducer(
                bootstrap_servers=KAFKA_BOOTSTRAP,
                value_serializer=lambda v: json.dumps(v).encode("utf-8"),
                acks='all',
                request_timeout_ms=30000
            )
            # Test connection
            producer.topics()
            print(f"✅ Connected to Kafka at {KAFKA_BOOTSTRAP}", flush=True)
            return producer
        except NoBrokersAvailable:
            print(f"⏳ Kafka not ready at {KAFKA_BOOTSTRAP}, retrying in {RETRY_DELAY}s...", flush=True)
            time.sleep(RETRY_DELAY)
        except Exception as e:
            print(f"❌ Kafka connection error: {e}", flush=True)
            time.sleep(RETRY_DELAY)

def generate_event():
    return {
        "event_id": f"evt_{int(time.time())}_{random.randint(1000,9999)}",
        "user_id": f"user_{random.randint(1,50)}",
        "value": round(random.uniform(0.1, 100.0), 2),
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    }

def main():
    print("🚀 Data Simulator starting...", flush=True)
    producer = create_producer()
    
    print(f"📤 Publishing to topic: {TOPIC}", flush=True)
    
    count = 0
    while True:
        try:
            event = generate_event()
            future = producer.send(TOPIC, value=event)
            # Wait for send confirmation (optional but safer)
            future.get(timeout=10)
            producer.flush()
            count += 1
            if count % 10 == 0:
                print(f"✅ Sent {count} events (latest: {event['event_id']})", flush=True)
            time.sleep(2)  # Adjust event rate
        except KeyboardInterrupt:
            print("\n🛑 Shutting down...", flush=True)
            producer.close()
            sys.exit(0)
        except Exception as e:
            print(f"⚠️ Send error: {e}", flush=True)
            time.sleep(5)

if __name__ == "__main__":
    main()